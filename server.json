{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.reefapi/reefapi-mcp",
  "title": "ReefAPI",
  "description": "One MCP server for 180+ live web-data APIs returning clean JSON from sites that block scrapers.",
  "version": "1.27.2",
  "websiteUrl": "https://reefapi.com/mcp",
  "icons": [
    {
      "src": "https://reefapi.com/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "repository": {
    "url": "https://github.com/reefapi/reefapi-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.reefapi.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your ReefAPI key from reefapi.com>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
